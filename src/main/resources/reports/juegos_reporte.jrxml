<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="juegos_reporte"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="logoEmpresa" class="java.io.InputStream"/>

    <field name="idProducto" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="categoria" class="com.juegos.model.Categoria"/>
    <field name="precio" class="java.lang.Double"/>
    <field name="stock" class="java.lang.Integer"/>
    <field name="descripcion" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="75">
            <image onErrorType="Blank">
                <reportElement x="0" y="5" width="65" height="65"/>
                <imageExpression><![CDATA[$P{logoEmpresa}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="80" y="10" width="520" height="30" forecolor="#4A0E17"/>
                <textElement verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{titulo} != null ? $P{titulo} : "JUEGOS.NET - Reporte de Videojuegos"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="80" y="42" width="300" height="18" forecolor="#666666"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Sistema de Gestión Comercial JUEGOS.NET]]></text>
            </staticText>
            <staticText>
                <reportElement x="600" y="15" width="90" height="16" forecolor="#4A0E17"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha de emisión:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm:ss">
                <reportElement x="695" y="15" width="107" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="72" width="802" height="1" forecolor="#CC1E36"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <rectangle>
                <reportElement x="0" y="2" width="802" height="22" backcolor="#4A0E17"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="5" y="2" width="40" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="45" y="2" width="160" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[Videojuego]]></text></staticText>
            <staticText><reportElement x="205" y="2" width="130" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[Categoría]]></text></staticText>
            <staticText><reportElement x="335" y="2" width="75" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[Precio (S/)]]></text></staticText>
            <staticText><reportElement x="410" y="2" width="55" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[Stock]]></text></staticText>
            <staticText><reportElement x="465" y="2" width="332" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><text><![CDATA[Descripción]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="5" y="2" width="40" height="20"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{idProducto}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="45" y="2" width="160" height="20"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="205" y="2" width="130" height="20"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{categoria} == null ? "Sin categoría" : $F{categoria}.getNombre()]]></textFieldExpression>
            </textField>
            <textField pattern="S/ #,##0.00">
                <reportElement x="335" y="2" width="75" height="20"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="410" y="2" width="55" height="20"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{stock}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="465" y="2" width="332" height="20"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="23" width="802" height="1" forecolor="#E0E0E0"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="2" width="802" height="1" forecolor="#CC1E36"/>
            </line>
            <textField>
                <reportElement x="0" y="4" width="300" height="18" forecolor="#777777"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Reporte generado por JUEGOS.NET"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="682" y="4" width="80" height="18" forecolor="#777777"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="762" y="4" width="40" height="18" forecolor="#777777"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
